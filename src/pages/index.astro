---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapExplorer from '../components/MapExplorer';
import companiesData from '../data/companies.json';
import geocodeCache from '../data/geocode-cache.json';
import { resolveCompanyLocations } from '../lib/resolve-company-locations';
import type { Company, CompanyData } from '../lib/types';

const companies = resolveCompanyLocations(companiesData as CompanyData[], geocodeCache) as Company[];
---

<BaseLayout fullHeight>
  <MapExplorer companies={companies} client:load />
</BaseLayout>
